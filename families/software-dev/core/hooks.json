{
  "agentflow": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "agentflow hook session-start --cli antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "agentflow hook pre-tool --cli antigravity",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "agentflow hook stop --cli antigravity",
        "timeout": 30
      }
    ]
  }
}
