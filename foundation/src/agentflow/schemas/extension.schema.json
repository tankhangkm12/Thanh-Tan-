{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentflow extension",
  "description": "The contract a child plugin uses to add to a family: roles, path rules, plan rules, scan tools and gates. schema_version is the version of this contract, not of the plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "family"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/identifier" },
    "family": { "$ref": "#/$defs/identifier" },
    "description": { "type": "string" },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "schema"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "schema": { "type": "object" }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "description": { "type": "string" }
        }
      }
    },
    "path_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "roles"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identifier" } }
        }
      }
    },
    "plan_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "when_paths", "done_when_contains"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "when_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "done_when_contains": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "scan_tools": { "type": "array", "items": { "$ref": "#/$defs/scan_tool" } },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "kind"],
        "properties": {
          "step": { "$ref": "#/$defs/identifier" },
          "kind": { "enum": ["plan-valid", "scans-clean", "conventions-reviewed"] }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "scan_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "step", "image", "args", "result"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "step": { "$ref": "#/$defs/identifier" },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "config_equals": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value"],
              "properties": { "key": { "type": "string" }, "value": { "type": "string" } }
            },
            "config_present": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "skip_note": { "type": "string" },
        "image": { "type": "string", "pattern": "^[^\\s:@]+:[^\\s:@]+$" },
        "network": { "enum": ["none", "host-gateway"], "default": "none" },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scope": { "enum": ["changed"] },
            "globs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "args": { "type": "array", "items": { "type": "string" } },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["json_findings", "exit_code"] },
            "items": { "type": "string" },
            "rule_field": { "type": "string" },
            "severity_field": { "type": "string" },
            "location_field": { "type": "string" },
            "message_field": { "type": "string" },
            "blocking_severities": { "type": "array", "items": { "type": "string" } },
            "require_field": { "type": "string" },
            "fail_exit_codes": { "type": "array", "items": { "type": "integer", "minimum": 1 } }
          },
          "allOf": [
            { "if": { "properties": { "kind": { "const": "json_findings" } } }, "then": { "required": ["rule_field"] } },
            { "if": { "properties": { "kind": { "const": "exit_code" } } }, "then": { "required": ["fail_exit_codes"] } }
          ]
        }
      }
    }
  }
}
