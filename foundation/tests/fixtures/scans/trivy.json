        {
          "VulnerabilityID": "CVE-2023-32681",
          "VendorIDs": [
            "GHSA-j8r2-6x86-q33q"
          ],
          "PkgName": "requests",
          "PkgIdentifier": {
            "PURL": "pkg:pypi/requests@2.19.0",
